@startuml UseCaseDiagram
title Прецеденти використання (Use Case Diagram) — Лабораторна робота №2*\nТема: «Програмне забезпечення на мережі факультету» (ФКНК КНУ, Варіант 9)

top to bottom direction
skinparam defaultFontName "Segoe UI"
skinparam roundcorner 10
skinparam shadowing false

skinparam actor {
    BackgroundColor #dbeafe
    BorderColor #1e40af
    FontSize 13
}

skinparam usecase {
    BackgroundColor #eff6ff
    BorderColor #2563eb
    ArrowColor #2563eb
    FontSize 12
    FontColor #0f172a
}

skinparam rectangle {
    BackgroundColor #f8fafc
    BorderColor #3b82f6
    FontSize 14
    FontColor #1e293b
}

actor "Користувач\n(Студент / Адмін)" as User
actor "Google Drive API\n(Хмарне сховище)" as GDrive <<External System>>

rectangle "Десктопний застосунок «Обробник XML мережі факультету» (.NET MAUI)" {

    usecase "UC-1: Завантажити XML з диска" as UC_LoadLocal
    usecase "UC-2: Завантажити XML з Google Drive" as UC_LoadDrive
    usecase "UC-3: Динамічно підвантажити параметри з XML" as UC_Preload
    usecase "UC-4: Обрати стратегію парсингу\n(SAX / DOM / LINQ to XML)" as UC_Strategy
    usecase "UC-5: Фільтрувати програмне забезпечення\n(кафедра, категорія, автор, ліцензія)" as UC_Filter
    usecase "UC-6: Очистити параметри пошуку (Clear)" as UC_Clear
    usecase "UC-7: Виконати XSLT-трансформацію у HTML" as UC_Transform
    usecase "UC-8: Відкрити HTML-звіт у браузері" as UC_Browser
    usecase "UC-9: Експортувати дані на Google Drive\n(XML / HTML через Factory Method)" as UC_Export
    usecase "UC-10: Переглянути журнал подій (Singleton Logger)" as UC_Logs
    usecase "UC-11: Переглянути довідку про програму" as UC_Help
    usecase "UC-12: Завершити роботу з додатком\n(з підтвердженням «Так / Ні»)" as UC_Exit

    ' Прихований вертикальний потік для красивого вирівнювання в одну колонку
    UC_LoadLocal -[hidden]down-> UC_LoadDrive
    UC_LoadDrive -[hidden]down-> UC_Preload
    UC_Preload -[hidden]down-> UC_Strategy
    UC_Strategy -[hidden]down-> UC_Filter
    UC_Filter -[hidden]down-> UC_Clear
    UC_Clear -[hidden]down-> UC_Transform
    UC_Transform -[hidden]down-> UC_Browser
    UC_Browser -[hidden]down-> UC_Export
    UC_Export -[hidden]down-> UC_Logs
    UC_Logs -[hidden]down-> UC_Help
    UC_Help -[hidden]down-> UC_Exit
}

' Зв'язки користувача (зліва)
User --> UC_LoadLocal
User --> UC_LoadDrive
User --> UC_Strategy
User --> UC_Filter
User --> UC_Clear
User --> UC_Transform
User --> UC_Export
User --> UC_Logs
User --> UC_Help
User --> UC_Exit

' Зв'язки із зовнішньою хмарою Google Drive (справа)
UC_LoadDrive --> GDrive : <<OAuth 2.0 / Read>>
UC_Export --> GDrive : <<OAuth 2.0 / Write>>

' Залежності include / extend
UC_LoadLocal ..> UC_Preload : <<include>>
UC_LoadDrive ..> UC_Preload : <<include>>
UC_Browser ..> UC_Transform : <<extend>>

@enduml